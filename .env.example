# Copiar a .env (nunca subir .env a git)
LLM_PROVIDER=openai          # openai (decidido, D-12) | none = modo sin IA
LLM_API_KEY=                 # clave de la API de OpenAI (cuenta de diego). Se pasa en privado, NUNCA en git
LLM_MODEL=gpt-5.6-luna       # el más rápido en nuestra prueba (~2 s); API Responses de OpenAI
LLM_TIMEOUT_S=8
DEMO_CACHE=true
LLM_REASONING_EFFORT=low    # none | low | medium (gpt-5.6-luna no admite minimal)
LLM_EXPLAIN_TIMEOUT_S=12    # la explicación es más larga que el parse
LLM_DAILY_LIMIT=1500        # máx. llamadas al LLM por día; después, modo sin IA
AI_RATE_PER_MIN=30          # máx. peticiones /api/ai por IP y minuto (429 si se supera)
